    "source": "//cpp\n#include \"daSBird_c.h\"\n#include \"Player.h\"\n// No real include header declares the following free-function interfaces.\n// Their scalar/pointer ABI and vector layout were checked from definitions.\nextern \"C\" void Vec3_Sub(Vector3 *out, Vector3 *a, Vector3 *b);\nextern \"C\" int Vec3_HorzLen(const Vector3 *v);\nextern \"C\" int RandomIntInternal(int *seed);\nextern \"C\" int data_0209e650;\nextern \"C\" void func_0201267c(unsigned int id, const Vector3 *v);\n\nextern \"C\" void func_ov009_0211145c(daSBird_c *self)\n{\n    if (self->mIsLeader) {\n        Player *player = self->ClosestPlayer();\n        if (!player) return;\n        Vector3 delta;\n        Vector3 difference;\n        Vec3_Sub(&difference, (Vector3 *)&self->mPosX,\n                 (Vector3 *)&player->mPosX);\n        delta = difference;\n        if (Vec3_HorzLen(&delta) > 2000 * 4096) return;\n        // The low nibble counts the leader and its followers.\n        int count = self->param1 & 15;\n        if (count > 1) {\n            int i;\n            int followers = count - 1;\n            for (i = 0; i < followers; ++i) {\n                daSBird_c *bird = (daSBird_c *)dActor_c::Spawn(\n                    343, 16, *(const Vector3 *)&self->mPosX, 0, self->mAreaId, -1);\n                if (bird) bird->func_ov009_02111224(self->uniqueID);\n            }\n        }\n        self->mTargetPos.x = -20 * 4096;\n        self->mTargetPos.z = -3990 * 4096;\n        func_0201267c(106, (const Vector3 *)&self->mCamSpacePosX);\n    }\n    self->mPrevAngleX = 5000 - (unsigned)RandomIntInternal(&data_0209e650) % 4000;\n    self->mPrevAngleY = (unsigned)RandomIntInternal(&data_0209e650) >> 16;\n    self->mFlySpeed = 40 * 4096;\n    self->mState = 3;\n    self->mFlags &= ~0x10000;\n}\n"
