{
  "base_commit": "6a985edeafb005d1951656cb63fa30b4d172393b",
  "scope": "Panel scene native dispatch, input state and moves-used fields, touch handling and renderer names.",
  "changes": [
    "Replace three placeholder slot-35 calls with the existing IsAltVariant method.",
    "Use native member-function dispatch in Input_Update, Shake_Update and IntroCard_Update; use native members in Scroll_Stop, Shake_Stop and IntroCard_Start.",
    "Name the existing bytes at +0x4fe0 and +0x4fe1 mInputState and mMovesUsed; migrate their reads and writes without changing layout.",
    "Remove the UpdateTouch shadow record and use mCount/mX/mY; name touch coordinates and the clipped flip-neighbourhood dimensions.",
    "Remove seven local shadow types and the private Ov006M8c dependency. Retain a data-only width view where native mWidth was already measured to differ.",
    "Rename the retained renderer layout view and its fields/locals to panel face, goal, flip frame, visibility and sprite priority.",
    "Update 27 compiler-local PMF label mappings, preserving every canonical ROM symbol and relocation target."
  ],
  "evidence": {
    "input_state": "Input_Update indexes the four-handler data_ov006_02142820 table with byte +0x4fe0; handlers advance it 0 to 1 to 2 to 3; ResetRound clears it.",
    "moves_used": "UpdateTouch increments +0x4fe1 only after accepting a panel hit. ResetRound and UpdateMoves clear it; StartSolveCheck compares it against mFlipCount.",
    "variant": "include/dScMgBase_c.h declares IsAltVariant at slot35 (+0x8c); the removed stand-ins used that same slot and no explicit arguments.",
    "sprite_priority": "DrawPanels argument 5 flows through Mg_RenderSubSpritePalMtx to the priority argument of OAM::Render; it is 1 in scene state6 and 0 otherwise.",
    "ownership_snapshot": "build/scene-physics14-queue.json, state bf99ec878a253a3437d8bd1bdb502ae49020609d: no active Panel class, old/new file or matching address resource.",
    "runtime_validation": "No emulator run needed: field meanings are supported by dispatch tables, accepted-touch updates and existing OAM parameter contracts. No new dynamic behavior claim.",
    "retained_limitations": [
      "DrawPanels native-member candidate changed 360 bytes to 388 bytes; retained measured layout view with readable names. Candidate: build/scene-physics14-render-native-candidate.cpp.",
      "Existing measured raw-width, lifetime and address-expression constraints remain; this is not a claim of complete Panel reconstruction.",
      "The local renderer view preserves oversized historical field spans; these are compiler-matching views rather than newly asserted production array extents."
    ]
  },
