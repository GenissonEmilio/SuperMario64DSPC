{
  "base_commit": "3d3e8ee8cd24591564fc817e68e39b903995dffb",
  "scope": "One-player and two-player Curling drag/throw fields and stone collision, separation, sliding and spin calculations.",
  "changes": [
    "Name Curling2 drag position, stylus grab offsets, throw speed/angle, swing state/reference/delta, cursor/counter visibility and cached top record. Name the shared swing reference/delta and cached record in Curling1.",
    "Correct Curling2 stone velX/velY to grabX/grabY: these fields store position minus stylus position, not velocity.",
    "Name collision participants, contact-frame normal/tangent components, resulting velocities, separation offsets, angle table indices and sine/cosine values. Keep variable lifetimes and arithmetic ordering intact.",
    "Name sliding heading/speed/position pointers and correct the reversed sine/cosine local labels. Name spin computation temporaries and correct Curling2 spin documentation to the horizontal velocity component.",
    "Clarify dragging locals and stale comments without changing layouts, public symbols, dispatch tables or production enrollment."
  ],
  "evidence": {
    "drag_fields": "DragBegin/Aim_WaitTouch capture the stylus offsets; DragUpdate/Aim_Swing add them to touch coordinates, compare y with the swing reference, and derive the throw angle/speed from displacement. DrawCursor and DrawCounter test their visibility bytes. Mg_GetTopRecord supplies the cached record.",
    "grab_offsets": "StoneSteer recomputes grabX/grabY as stone position minus touch coordinates, shifted to Fix12. Its next held-touch update adds grabX to the touch x coordinate. No new velocity semantics are inferred.",
    "physics": "SeparateStones projects a 26-pixel separation along the contact angle. Collision resolution rotates velocities into the contact frame and exchanges normal components. Curling1 additionally replaces a zero hit y velocity with half the moving stone y velocity before rotation. The trig table odd element is cosine: sliding uses it for x, and spin negates and scales the corresponding x velocity.",
    "ownership": "Queue19 state 0bc3961af764aec61da2f0dcff9b6fbe41e6f1ab: no active Curling class/file reservations or overlapping ov006 ranges 0x020e0638..0x020e6c28. Curling1 ends and Curling2 starts at 0x020e3854.",
    "runtime_validation": "No new emulator run was needed: these names follow explicit arithmetic, stores and draw conditions. Unknown fields remain unknown; no new gameplay behavior is claimed from runtime observation.",
    "retained_constraints": [
      "Preserve existing pragmas, Fix12 scalar ABI calls, dispatch tables, raw indexed addressing and local DragView. Previously measured native access failures remain documented rather than retried.",
      "Preserve separate inner/outer separation temporaries, collision field pointer lifetimes, explicit wide cosine/sine copies, hit normal load ordering, and reused displacement scratch variables.",
      "Preserve collision thresholds, rounding points, signed/unsigned casts, declaration order, control flow, and the different one-player/two-player collision boundary behavior."
    ]
  },
