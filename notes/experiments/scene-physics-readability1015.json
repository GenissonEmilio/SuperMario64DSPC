        "src/game/stages/d_scene.cpp: dScene_c::SetFaders stores its dFdBrightness_c pointer into the global",
        "include/dFdBrightness_c.h: virtual slot 5",
        "src/runtime/graphics/fader/d_fader.cpp: IsAtStart tests currInterp == 0"
      ]
    },
    {
      "claim": "Cylinder field accesses and line endpoints use existing measured layouts.",
      "sources": [
        "include/dCc_c.h: radius 0x04, height 0x08, flags 0x18, vulnFlags 0x1c, hitFlags 0x20",
        "include/dM3dGLin.h: start 0x00, end 0x0c",
        "src/engine/collision/d_cc.cpp: distance and overlap arithmetic"
      ]
    }
  ],
