{
  "base_commit": "88282dc9e5d9fbcf80ad789e0723fe025f437b34",
  "scope": "Level-object record loading, entrance parameter assembly, category/star dispatch and collision/intro setup readability.",
  "changes": [
    "Rename loader locals for table entries, actor IDs/indices, position conversion, death-table indices and object/player indices.",
    "Name entranceIndex, entranceKind, savedCharacter, playerCharacter, spawnParam and wipeType according to their source and use.",
    "Name the two local DoorEntry halfwords param and type; keep their storage widths, offsets and bit extraction unchanged.",
    "Name categoryAndStar, starFilter and loader in the table dispatcher, separating its low-five-bit category index from its upper-three-bit star filter.",
    "Clarify collision-file, subtable, area, entrance and intro-state locals; consistently format implementations without changing expression or loop shape."
  ],
  "evidence": {
    "entrance": "LoadEntranceObjects advances its StandardEntry pointer by entranceIndex, then walks the player count. It packs the saved character, per-player character, player index and entrance kind into spawnParam. Player::SetRealCharacter writes both data0209caa0[0x41] and data02092128[mPlayerNo]; StartFile copies the former into the latter. Their loader reads and mode1 overrides to3 remain identical.",
    "dispatch": "The entry byte indexes the category loader through &0x1f; its upper3 bits must be0 or equal data0209f220. LoadLevel records starID in data0209f1f0 (or reuses data0209f220 for a negative starID), and dScStage_c::InitResources copies data0209f1f0 into data0209f220. The daBtn_c TrackStar documentation corroborates this selected-star role. The eight-byte walk and raw void-pointer callback signature remain.",
    "door": "The first local halfword is forwarded as the low spawn parameter and supplies two rotation nibbles. The low five bits of the second index the actor-ID and high-parameter tables. No claim is made about unused bits.",
    "ownership": "Queue29 state5803e2a26b3c986b2de0039a344eda7c16202bca has no active dScStage_c/LVL_Overlay class, current or historical loader-file, or ov0020x020fe190..0x020fea4c range conflict. No shared header, symbols or delinks changed.",
    "runtime_validation": "No new emulator claim: this pass names explicit table, field and call relationships. Mode0/1/2 locals retain numeric descriptions where this pass does not establish a stronger mode name.",
    "retained_constraints": [
      "Keep highest-address-first source order and the existing text-only production range. External tables remain data owned elsewhere.",
      "Keep the measured dActor_c Spawn declaration, scalar Fix12 minimap ABI spelling, local DoorEntry and LVL_Overlay_Layout views.",
      "Keep bottom-tested teleport-source iteration, big-endian exit parameter assembly, separate coordinate temporaries, raw eight-byte dispatch and all cast/address forms.",
      "Keep game-mode/intro temporary assignments, parameter rereads, unused loader parameters and existing global identifiers. This pass does not redesign the loader records or alter behavior."
    ]
  },
